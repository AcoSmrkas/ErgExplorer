{% extends "layout.njk" %}

{% block styles %}
	<!-- build:css styles/storage-rent.css -->
	<link rel="stylesheet" href="styles/storage-rent.css?v=2">
	<!-- endbuild -->
{% endblock %}

{% block navigation %}
		{% import 'macros/nav-macro.njk' as nav %}
		{{nav.active('storage-rent')}}
{% endblock %}

{% block content %}
	<div class="row w-100">
		<div class="col-md-12 mb-3 mb-md-4 d-flex align-items-center">
			<h2 class="m-0">Storage Rent</h2>
			<span class="rent-help ms-2" tabindex="0" role="button" aria-label="About storage rent" data-bs-toggle="tooltip" data-bs-placement="bottom" title="A box left unmoved for 4 years can be charged rent: about 0.1 ERG, or the whole box if it holds less. Moving it resets the clock.">?</span>
		</div>
	</div>

	<div id="rentStatsHolder" style="display: none;" class="rent-stats mb-4">
		<div id="rentNowCard" class="div-cell-dark rent-card">
			<div class="card-body">
				<h6 class="card-subtitle mb-2 text-muted">Collectable now</h6>
				<div class="rent-card-main">
					<span id="rentNowRent" class="rent-card-erg">-</span>
					<span id="rentNowRentUsd"></span>
				</div>
				<div class="rent-card-row">
					<span class="rent-card-label">Tokens</span>
					<span id="rentNowTokens" class="rent-card-value">-</span>
				</div>
				<div class="rent-card-row">
					<span class="rent-card-label">Total</span>
					<span id="rentNowTotal" class="rent-card-value">-</span>
				</div>
			</div>
		</div>
		<div id="rentDayCard" class="div-cell-dark rent-card">
			<div class="card-body">
				<h6 class="card-subtitle mb-2 text-muted">Next 24 hours</h6>
				<div class="rent-card-main">
					<span id="rentDayRent" class="rent-card-erg">-</span>
					<span id="rentDayRentUsd"></span>
				</div>
				<div class="rent-card-row">
					<span class="rent-card-label">Tokens</span>
					<span id="rentDayTokens" class="rent-card-value">-</span>
				</div>
				<div class="rent-card-row">
					<span class="rent-card-label">Total</span>
					<span id="rentDayTotal" class="rent-card-value">-</span>
				</div>
			</div>
		</div>
		<div id="rentWeekCard" class="div-cell-dark rent-card">
			<div class="card-body">
				<h6 class="card-subtitle mb-2 text-muted">Next 7 days</h6>
				<div class="rent-card-main">
					<span id="rentWeekRent" class="rent-card-erg">-</span>
					<span id="rentWeekRentUsd"></span>
				</div>
				<div class="rent-card-row">
					<span class="rent-card-label">Tokens</span>
					<span id="rentWeekTokens" class="rent-card-value">-</span>
				</div>
				<div class="rent-card-row">
					<span class="rent-card-label">Total</span>
					<span id="rentWeekTotal" class="rent-card-value">-</span>
				</div>
			</div>
		</div>
		<div id="rentMonthCard" class="div-cell-dark rent-card">
			<div class="card-body">
				<h6 class="card-subtitle mb-2 text-muted">Next 30 days</h6>
				<div class="rent-card-main">
					<span id="rentMonthRent" class="rent-card-erg">-</span>
					<span id="rentMonthRentUsd"></span>
				</div>
				<div class="rent-card-row">
					<span class="rent-card-label">Tokens</span>
					<span id="rentMonthTokens" class="rent-card-value">-</span>
				</div>
				<div class="rent-card-row">
					<span class="rent-card-label">Total</span>
					<span id="rentMonthTotal" class="rent-card-value">-</span>
				</div>
			</div>
		</div>
	</div>

	<div id="rentDataHolder" style="display: none;" class="col-md-12">
		{% include "partials/pagination.njk" %}

		<table class="table table-dark table-striped table-mobile rounded-data-table rent-table">
			<thead>
				<tr>
					<th scope="col">Box</th>
					<th scope="col">Address</th>
					<th scope="col" class="text-end">Created</th>
					<th scope="col" class="text-end">Rent</th>
					<th scope="col" class="text-end">Tokens</th>
					<th scope="col" class="text-end">Total</th>
					<th scope="col" class="text-end">Due</th>
				</tr>
			</thead>
			<tbody id="rentTableBody">
			</tbody>
		</table>

		{% include "partials/pagination.njk" %}
	</div>

	{% include "partials/error-message.njk" %}

	{% include "partials/loading.njk" %}

	<br>
{% endblock %}

{% block scripts %}
		<script src="./scripts/common/prices.js?v=44"></script>
		<script src="./scripts/common/pagination.js?v=42"></script>
		<script src="./scripts/common/count-up.js?v=1"></script>
		<script src="./scripts/storage-rent.js?v=5"></script>
{% endblock %}
