{% extends "layout.njk" %}

{% block styles %}
	<link rel="stylesheet" href="styles/mempool.css?v=1">
{% endblock %}

{% block navigation %}
	{% import 'macros/nav-macro.njk' as nav %}
	{{nav.active('mempool')}}
{% endblock %}

{% block content %}
	<div class="col-md-12">
		<div class="row w-100">
			<div class="col-md-12 mb-3 mb-md-4">
				<h2 class="m-0">Mempool</h2>
			</div>
		</div>

		<!-- The same pool, streamed: a way into live.ergexplorer.com (mainnet only, hidden on testnet by mempool.js) -->
		<div id="liveCta" class="row w-100">
			<a class="live-cta div-cell-dark" href="https://live.ergexplorer.com">
				<span class="live-cta-badge"><span class="live-cta-dot"></span>LIVE</span>
				<span class="live-cta-text">
					<strong>Watch the mempool in real time</strong>
					<span>New transactions appear the moment they reach the network, labelled by what they do.</span>
				</span>
				<span class="live-cta-button">Open Live <i class="fas fa-arrow-right"></i></span>
			</a>
		</div>

		<br>

		<div id="mempoolHolder" style="display: none;">
		
			{% include "partials/pagination.njk" %}

			<div class="row w-100">
				<table class="table table-dark table-striped table-mobile rounded-data-table">
					<thead>
						<tr>
							<th scope="col">Id</th>
							<th scope="col">Time</th>
							<th scope="col">Inputs</th>
							<th scope="col">Outputs</th>
							<th scope="col">Size</th>
						</tr>
					</thead>
				 
					<tbody id="transactionsTableBody">						
					</tbody>
				</table>
			</div>

			{% include "partials/pagination.njk" %}
			
		</div>
		
		{% include "partials/error-message.njk" %}
	</div>

	{% include "partials/loading.njk" %}
{% endblock %}

{% block scripts %}
	<script src="./scripts/common/pagination.js?v=41"></script>
	<script src="./scripts/mempool.js?v=43"></script>
{% endblock %}
