{% extends "layout.njk" %}

{% block styles %}
	<!-- build:css styles/index.css -->
		<link rel="stylesheet" href="styles/index.css">
	<!-- endbuild -->
{% endblock %}

{% block navigation %}
	{% import 'macros/nav-macro.njk' as nav %}
	{{nav.active('home')}}
{% endblock %}

{% block content %}
	<div id="txHolder" style="display: none;">
		<div id="tx"></div>
	</div>

	<div class="row w-100 div-cell-dark">
		<div class="col-md-6 col-lg-4 p-1 pe-0 ps-0 pe-lg-3">
			<div class="d-flex">
				<div class="me-3 text-center mx-auto index-card-symbol-holder">
					<img id="erg-logo" src="./images/logo-new.png" alt="Ergo coin" style="width:50px; height:50px;">
				</div>
				<div class="flex-grow-1">
					<p><span class="erg-span"><b>ERG</b></span> price</p>
					<h2 class="text-white index-card-values skeleton" id="ergPrice" class="skeleton"></h2>
				</div>
			</div>
			<hr class="my-3">
			<div class="d-flex">
				<div class="me-3 text-center mx-auto index-card-symbol-holder">
					<i class="fas fa-globe erg-span index-card-symbol"></i>
				</div>
				<div class="flex-grow-1">
					<p><strong class="erg-span"></strong>Market cap</p>
					<h2 class="text-white index-card-values skeleton" id="marketCap" class="skeleton"></h2>
				</div>
			</div>
		</div>
		<hr class="my-3 d-block d-md-none">
		<div class="col-md-6 col-lg-4 p-1 pe-0 ps-0 pe-lg-3">
			<div class="d-flex">
				<div class="me-3 text-center mx-auto index-card-symbol-holder">
					<i class="fas fa-bars erg-span index-card-symbol"></i>
				</div>
				<div class="flex-grow-1">
					<p>Block height</p>
					<h2 id="blockHeight" class="text-white index-card-values skeleton"></h2>
				</div>
			</div>
			<hr class="my-3">
			<div class="d-flex">
				<div class="me-3 text-center mx-auto index-card-symbol-holder">
					<i class="fas fa-list erg-span index-card-symbol"></i>
				</div>
				<div class="flex-grow-1">
					<p><strong class="erg-span"></strong>Daily transactions</p>
					<h2 class="text-white index-card-values skeleton" id="totalTransactions" class="skeleton"></h2>
				</div>
			</div>
		</div>		
		<hr class="my-3 d-block d-lg-none">
		<div class="col p-1 ps-lg-3 border-lg-start">
			<h2 class="erg-span" style="font-size:1.7em; margin-bottom: 0;">Protocol information</h2>
			<br>
			<h5 style="font-size:1em" class="text-light">Version: <span class="text-white skeleton" id="ergVersion"></span></h2>
			<h5 style="font-size:1em" class="text-light">Circulating Supply: <span class="skeleton" id="ergSupply"></span></h2>
			<h5 style="font-size:1em" class="text-light">Max Supply: <span class="skeleton" id="ergTotal"></span></h2>
		</div>
	</div>
	<div id="tokenLoading" style="display: block;height: 350px;" class="row w-100">
		<div class="col-12">
			{% include "partials/loading.njk" %}
		</div>
	</div>
	<div id="tokenView" style="display: none" class="row w-100">
		<div class="col-lg-6 p-0 pe-lg-3">
			<h2 class="subtitle ps-1 ps-sm-0">Top 10 by trade volume</h2>
			<table class="table table-striped table-dark rounded-data-table">
				<thead>
					<tr>
						<th scope="col">Token</th>
						<th scope="col">Volume</th>
					</tr>
				</thead>

				<tbody id="tokensVolumeTableBody">

				</tbody>
			</table>
		</div>
		<div class="col-lg-6 p-0 ps-lg-3">
			<div class="row w-100 p-0 ps-1 ps-sm-0">
				<div class="col p-0">
					<h2 class="subtitle text-nowrap"><span class="d-none d-sm-inline">Top gainers</span><span class="d-sm-none">Gainers</span> &amp; losers</h2>
				</div>
				<div class="col-auto p-0 token-chart-controls">
					<input id="showGainersLosers24h" onclick="printGainersLosers24h()" class="btn btn-info token-chart-range-btn" type="button" value="24h">
					<input id="showGainersLosers7d" onclick="printGainersLosers7d()" class="btn btn-primary token-chart-range-btn" type="button" value="7d">
					<input id="showGainersLosers30d" onclick="printGainersLosers30d()" class="btn btn-primary token-chart-range-btn" type="button" value="30d">
				</div>
			</div>
			<table class="table table-dark table-striped rounded-data-table">
				<thead>
					<tr>
						<th scope="col">Token</th>
						<th scope="col">Price</th>
						<th scope="col">Change</th>
					</tr>
				</thead>

				<tbody id="tokensGainersTableBody">

				</tbody>
			</table>
		</div>
	</div>	
	 <div id="txView" style="display: none" class="row w-100">
		<h2 class="subtitle ps-1 ps-sm-0">Latest big transactions</h2>
		<table class="table table-dark table-striped table-mobile table-sm-sm rounded-data-table">
			<thead>
				<tr>
					<th scope="col">Tx</th>
					<th scope="col" style="min-width: 156px">Time</th>
					<th scope="col">From</th>
					<th scope="col">To</th>
					<th scope="col">Value</th>
				</tr>
			</thead>

			<tbody id="transactionsTableBody">

		  </tbody>
		</table>
	</div>
	<h2 class="subtitle ps-1 ps-sm-0">24h Stats</h2>
	<div class="row w-100 two-column-holder-lg">
		<div id="statsHolderLeft" class="col-lg-6 div-cell-dark p-0">
			<h3 class="stats-heading erg-span">Block summary</h3>
					<table class="table-dark key-value-table">
						<tbody>
							<tr>
								<td><strong>Blocks mined</strong></td>
								<td id="statsBlocksMined" class="stats-value skeleton"></td>
							</tr>
							<tr>
								<td><strong><span class="d-none d-xl-inline">Average mining time</span><span class="d-xl-none">Avg mine time</span></strong></td>
								<td id="statsAverageMiningTime" class="stats-value skeleton"></td>
							</tr>
							<tr>
								<td><strong>Coins mined</strong></td>
								<td id="statsCoinsMined" class="stats-value skeleton"></td>
							</tr>
						</tbody>
					</table>
			<h3 class="stats-heading erg-span">Transactions summary</h3>
					<table class="table-dark key-value-table">
						<tbody>
							<tr>
								<td><strong><span class="d-none d-xl-inline">Number of Transactions</span><span class="d-xl-none">Transactions</span></strong></td>
								<td id="statsNumberOfTransactions" class="stats-value skeleton"></td>
							</tr>
							<tr>
								<td><strong><span class="d-none d-xl-inline">Total Transaction Fees</span><span class="d-xl-none">Transaction fees</span></strong></td>
								<td id="statsTotalTransactionFees" class="stats-value skeleton"></td>
							</tr>
						</tbody>
					</table>
		</div>
		<div id="statsHolderRight" class="col-lg-6 div-cell-dark p-0">
			<h3 class="stats-heading erg-span">Mining cost</h3>
					<table class="table-dark key-value-table">
						<tbody>
							<tr>
								<td><strong><span class="d-none d-xl-inline">Total Miners Revenue</span><span class="d-xl-none">Miners revenue</span></strong></td>
								<td id="statsTotalMinersRevenue" class="stats-value skeleton"></td>
							</tr>
							<tr>
								<td><strong><span class="d-none d-xl-inline">% Earned From Transaction Fees</span><span class="d-xl-none">% From fees</span></strong></td>
								<td id="statsEarnedFromTransactionFees" class="stats-value skeleton"></td>
							</tr>
							<tr>
								<td><strong><span class="d-none d-xl-inline">% Of Transaction Volume</span><span class="d-xl-none">% Of volume</span></strong></td>
								<td id="statsOfTransactionVolume" class="stats-value skeleton"></td>
							</tr>
							<tr>
								<td><strong><span class="d-none d-xl-inline">Cost per Transaction</span><span class="d-xl-none">Cost per tx</span></strong></td>
								<td id="statsCostPerTransaction" class="stats-value skeleton"></td>
							</tr>
							<tr>
								<td><strong>Difficulty</strong></td>
								<td id="statsDifficulty" class="stats-value skeleton"></td>
							</tr>
							<tr>
								<td><strong>Hash Rate</strong></td>
								<td id="statsHashRate" class="stats-value skeleton"></td>
							</tr>
						</tbody>
					</table>
		</div>
	</div>

	<br>
{% endblock %}

{% block scripts %}
	<script src="https://unpkg.com/@sjaakp/telex@2.0.7/dist/telex.js"></script>
	<script src="./scripts/common/prices.js?v=44"></script>
	<script src="./scripts/index.js?v=45"></script>
{% endblock %}
