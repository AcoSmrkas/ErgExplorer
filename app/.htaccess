RewriteEngine on
RewriteRule ^en/(.*)$ /$1 [L,R=301,NE]
RewriteRule ^ru/(.*)$ /$1 [L,R=301,NE]
RewriteRule ^(addresses|transactions|boxes|blocks|mempool|issued-tokens|token|addressbook|latest-blocks|rich-list)/.*$ $1.html [L]
RewriteRule ^ergosanta$ https://ergosanta.ergexplorer.com [L,R=301,NE]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# No ETags: Apache adds -gzip to them when compressing, then never matches them again, so every
# check back would be a full 200. Without them browsers check back with Last-Modified, which works.
FileETag None

<IfModule mod_headers.c>
	# Pages: browsers check back on every visit (a cheap 304 when nothing changed), so a deploy
	# shows up at once and its bumped ?v= stylesheets and scripts get fetched
	<FilesMatch "\.html$">
		Header set Cache-Control "no-cache"
	</FilesMatch>

	# Stylesheets and scripts: a week with a ?v=, since bumping it fetches the new file. Not a year
	# with immutable, because the bumps are by hand and a forgotten one has to wear off by itself.
	# Without a ?v= they check back every time, like pages.
	<FilesMatch "\.(css|js)$">
		Header set Cache-Control "no-cache"
		Header set Cache-Control "public, max-age=604800" "expr=%{QUERY_STRING} =~ /(^|&)v=/"
	</FilesMatch>

	# Images and fonts: a month. They have no ?v=, so a new one needs a new filename to show up sooner.
	<FilesMatch "\.(png|jpe?g|webp|svg|ico|woff2?)$">
		Header set Cache-Control "public, max-age=2592000"
	</FilesMatch>
</IfModule>
